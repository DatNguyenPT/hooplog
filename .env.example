# Copy this file to .env.local (git-ignored) and fill in the two Supabase values from the dashboard
# (Project Settings > API Keys). Restart the dev server after changing it.
#
# Only the publishable key belongs here. Never put the secret or service_role key in this app:
# anything in an EXPO_PUBLIC_ variable is shipped inside the app and can be read by anyone.
#
# Leave both empty to run without accounts: the app works the same, and the Account screen says
# accounts are not set up in this build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Where HoopLog's public pages live (the site/ folder, published by GitHub Pages). The
# link in the sign-up email lands on its confirm/ page. Leave it empty to use
# https://datnguyenpt.github.io/hooplog/. It must be an https address, and Supabase must allow it
# under Authentication > URL Configuration: see docs/SUPABASE_AUTH_SETUP.md.
EXPO_PUBLIC_SITE_URL=
